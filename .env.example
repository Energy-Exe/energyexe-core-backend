# EnergyExe Core Backend — environment template.
# Every variable app/core/config.py reads, grouped. Copy to .env and fill in what
# you need; anything left empty falls back to the default in config.py (and most
# optional integrations are simply OFF when their key is empty). Never commit .env.
# In AWS these values come from Secrets Manager via the ECS task definition.

# --- Core -------------------------------------------------------------------
DEBUG=true
LOG_LEVEL=DEBUG
# SECRET_KEY signs JWTs. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=14400
ALLOWED_HOSTS=["*"]
# JSON array. Defaults already include dashboard./app.energyexe.com and localhost dev ports.
BACKEND_CORS_ORIGINS=["*"]

# --- Server -----------------------------------------------------------------
HOST=127.0.0.1
# App default is 8001 (also the Docker image / compose port). The local-dev
# convention is 8002 — the workspace `start` skill and client-ui api.ts assume it.
PORT=8001
RELOAD=true

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/energyexe_db
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_ECHO=
DB_POOL_PRE_PING=
DB_POOL_RECYCLE=
DB_POOL_TIMEOUT=
DB_COMMAND_TIMEOUT=
PIPELINE_PEER_AGG_TIMEOUT_S=

# --- Cache / rate limit (Valkey or Redis; optional, features fail open) -----
REDIS_URL=redis://localhost:6379

# --- Email (Resend) — leave RESEND_API_KEY blank to no-op sends in dev ------
RESEND_API_KEY=
EMAILS_FROM_EMAIL=noreply@energyexe.com
EMAILS_FROM_NAME=EnergyExe
SUPPORT_EMAIL=hello@energyexe.com
EMAIL_VERIFICATION_EXPIRE_HOURS=
PASSWORD_RESET_EXPIRE_HOURS=
INVITATION_EXPIRE_DAYS=

# --- Portal URLs used in transactional email links --------------------------
CLIENT_PORTAL_URL=http://localhost:3006
ADMIN_PORTAL_URL=http://localhost:3005

# --- Legal document versions (must match client-ui src/lib/legal-versions.ts)
TERMS_VERSION=
PRIVACY_VERSION=

# --- Error tracking (GlitchTip via Sentry SDK; empty DSN = disabled) --------
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
# SENTRY_RELEASE is baked into the image from the GIT_SHA build arg; leave unset locally.
SENTRY_RELEASE=

# --- External data APIs -----------------------------------------------------
ENTSOE_API_KEY=
ENTSOE_DEFAULT_AREAS=
ENTSOE_FETCH_BATCH_DAYS=
ENTSOE_RATE_LIMIT_REQUESTS=
ENTSOE_RATE_LIMIT_PERIOD=
ELEXON_API_KEY=
EIA_API_KEY=
# Copernicus CDS (ERA5 weather)
CDSAPI_URL=
CDSAPI_KEY=

# --- LLM: legacy per-windfarm commentary ------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_CACHE_DURATION_HOURS=
LLM_MAX_COST_PER_REPORT=

# --- LLM: reports platform narratives (always Anthropic) --------------------
REPORTS_LLM_MODEL_SECTION=
REPORTS_LLM_MODEL_SUMMARY=
REPORTS_MAX_COST_USD=

# --- SCADA ------------------------------------------------------------------
SCADA_INGESTION_ENABLED=

# --- Brain agent ------------------------------------------------------------
# "authenticated" (default) or "superusers"
BRAIN_AGENT_ACCESS_POLICY=
BRAIN_MODEL=
# Read-only Postgres roles the agent connects with (docs/features/brain-agent/readonly-role.md)
BRAIN_AGENT_RO_USER=
BRAIN_AGENT_RO_PASSWORD=
BRAIN_AGENT_CLIENT_RO_USER=
BRAIN_AGENT_CLIENT_RO_PASSWORD=
# Source-code access for the agent sandbox
CODE_REPOS_DIR=
GITHUB_TOKEN=
# S3 for agent image / upload persistence (empty = disabled)
S3_BUCKET_NAME=
S3_REGION=

# --- Legacy Valkey/Celery settings still declared in config.py (unused) -----
VALKEY_PUBLIC_HOST=
VALKEY_PUBLIC_PORT=
VALKEY_PASSWORD=
VALKEY_USER=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
